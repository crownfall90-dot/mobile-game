; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vita"
config/name_localized={
"en": "Vita",
"ru": "Vita"
}
config/description="Головоломка «тяни засов»: помоги маме и дочке обрести уютный дом."
config/version="0.3.2"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.07058824, 0.047058824, 0.14117648, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Loc="*res://scripts/core/loc.gd"
Profile="*res://scripts/core/profile.gd"
Game="*res://scripts/core/game.gd"
Economy="*res://scripts/core/economy.gd"
Sfx="*res://scripts/audio/sfx.gd"
Monetization="*res://scripts/core/monetization.gd"
Router="*res://scripts/core/router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1800.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07058824, 0.047058824, 0.14117648, 1)
